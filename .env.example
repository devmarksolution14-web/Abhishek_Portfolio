# Copy this file to .env.local and fill in the values.

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form messages are delivered (your inbox)
CONTACT_TO_EMAIL=you@example.com

# Sender shown on the email. Must be on a domain you verified in Resend.
# While testing you can use Resend's shared sender: onboarding@resend.dev
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Public URL of the deployed site (used for SEO, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
